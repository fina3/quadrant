{
  "manifest_version": 3,
  "name": "Quadrant",
  "version": "1.0",
  "description": "Eisenhower Matrix sticky note",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": { "default_title": "Toggle Quadrant" },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
